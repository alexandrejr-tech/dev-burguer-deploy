# Copie para .env (teste local) ou cadastre cada linha no Dokploy (produção).
# Nunca faça commit do .env.
# Use senhas só com letras e números (ex.: openssl rand -hex 24): elas entram
# na URL de conexão do Mongo, e caracteres como @ : / quebram essa URL.

# ---------- Postgres ----------
POSTGRES_USER=devburguer
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=dev-burguer-db

# ---------- Mongo ----------
MONGO_USER=devburguer
MONGO_PASSWORD=troque-por-uma-senha-forte

# ---------- API ----------
# Local: http://localhost:3001 | Produção: https://api.devburguer.alexandrejr.tech
APP_URL=http://localhost:3001
# Local: http://localhost:8080 | Produção: https://devburguer.alexandrejr.tech
CORS_ORIGIN=http://localhost:8080
# Proxies entre o visitante e a API: 1 atrás do Traefik do Dokploy
TRUST_PROXY_HOPS=1
JWT_SECRET=troque-por-um-segredo-forte
JWT_EXPIRES_IN=7d
STRIPE_SECRET_KEY=sk_test_sua_chave_aqui
DELIVERY_FEE=500

# ---------- Front (build args) ----------
# Local: http://localhost:3001 | Produção: https://api.devburguer.alexandrejr.tech
VITE_API_URL=http://localhost:3001
VITE_STRIPE_PUBLIC_KEY=pk_test_sua_chave_aqui

# ---------- Contextos de build ----------
# Local: deixe comentado (usa as pastas vizinhas ../dev-burguer-api e ../dev-burguer-interface).
# Dokploy: URL pública do Git com a branch depois do #.
# API_CONTEXT=https://github.com/alexandrejr-tech/dev-burguer-api.git#master
# FRONT_CONTEXT=https://github.com/alexandrejr-tech/dev-burguer-interface.git#main
